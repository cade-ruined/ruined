# ─── Shopify Storefront (headless commerce) ──────────────────────────────────
# Copy to `.env.local` and fill in. With these unset, Shopify-backed catalogue
# and checkout routes remain empty while the walk continues to show its
# curated Coming Soon state.

# Your store's myshopify domain (no protocol), e.g. ruined-studio.myshopify.com
SHOPIFY_STORE_DOMAIN=

# Public Storefront API access token.
# Shopify admin → Settings → Apps and sales channels → Develop apps →
# create an app → Storefront API → install → copy the Storefront access token.
# Grant: unauthenticated_read_product_listings, unauthenticated_write_checkouts.
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Optional — Storefront API version (defaults to 2026-07 in src/lib/shopify.ts).
SHOPIFY_API_VERSION=2026-07

# Shopify app client secret used by /api/revalidate to verify the
# X-Shopify-Hmac-Sha256 webhook signature. Do not use the public Storefront
# token here.
SHOPIFY_WEBHOOK_SECRET=

# ─── Stripe Membership Billing ───────────────────────────────────────────────
# Stripe is for Ruined membership, consulting invoices, and related tax only.
# Shopify remains the system of record for the retail store and physical goods.
# Use test-mode keys locally, then separate live-mode secrets in production.
# Never prefix either server secret with NEXT_PUBLIC_.

# Test secret or restricted key. A restricted key should grant only the
# Checkout, Billing, Customer Portal, Customer, Invoice, and webhook reads/writes
# required by this integration.
STRIPE_SECRET_KEY=

# Signing secret for this exact webhook endpoint/environment. The Stripe CLI
# and the Dashboard endpoint each issue a different whsec_ value.
STRIPE_WEBHOOK_SECRET=

# One recurring Price configured in Stripe Dashboard. The browser never sends
# an amount or Price ID; the server reads this fixed value.
STRIPE_MEMBERSHIP_PRICE_ID=

# Version written to Checkout and subscription metadata when the member accepts
# the current membership agreement before entering Stripe Checkout.
STRIPE_MEMBERSHIP_AGREEMENT_VERSION=

# Keep false until the Ruined Stripe account has an active tax registration,
# verified business origin, and a confirmed membership Product tax code.
STRIPE_TAX_ENABLED=false

# Minimum age shown in the versioned member attestation. This is configurable
# because the policy still needs final legal confirmation before production.
MEMBERSHIP_MINIMUM_AGE=16

# Durable Postgres storage for webhook idempotency and the billing/member map.
# Run `npm run db:migrate:platform` before registering the webhook endpoint.
DATABASE_URL=

# ─── My Ruined platform identity ─────────────────────────────────────────────
# Preview is honored only outside production and never creates a fake session.
# Set connected after Supabase Auth and the platform migration are ready.
PLATFORM_MODE=preview

# Supabase Project URL and publishable key. These power passwordless identity;
# Postgres remains the canonical member/state store.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Reserved for server-side account provisioning and invitation operations.
# Never prefix this key with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Optional endpoint for sendBeacon Web Vitals payloads.
NEXT_PUBLIC_ANALYTICS_ENDPOINT=

# Canonical production origin. Keep this exact value in production so metadata,
# robots.txt, and sitemap.xml all resolve to the public brand domain.
NEXT_PUBLIC_SITE_URL=https://theruinedproject.com

# Public destination used by fallback product enquiry links.
NEXT_PUBLIC_CONTACT_EMAIL=connect@theruinedproject.com

# Public email interests and consent are stored in the Supabase Postgres
# database above. Campaign delivery is intentionally separate. Add a Resend
# API key only when the outbox worker and signed webhook receiver are enabled.
RESEND_MARKETING_ENABLED=false
RESEND_API_KEY=
RESEND_FROM_EMAIL=Ruined <connect@theruinedproject.com>
# One general Ruined updates audience shared by every public signup form.
RESEND_TOPIC_UPDATES_ID=
# Legacy topic IDs remain configured only to preserve historical preferences.
RESEND_TOPIC_ARTIFACTS_ID=
RESEND_TOPIC_STORE_ID=

# Resend signs events sent to /api/webhooks/resend with this endpoint-specific
# secret. The worker route accepts Vercel Cron requests using CRON_SECRET.
RESEND_WEBHOOK_SECRET=
CRON_SECRET=

# Dedicated HMAC key for public signup throttling. Generate a separate random
# value; do not reuse the Supabase, Resend, Stripe, or cron secrets.
COMMUNICATION_RATE_LIMIT_SECRET=
CONTACT_WEBHOOK_URL=
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=
