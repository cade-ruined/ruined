# ─── Shopify Storefront (headless commerce) ──────────────────────────────────
# Copy to `.env.local` and fill in. With these unset, Shopify-backed catalogue
# and checkout routes remain unavailable.

# Your store's myshopify domain (no protocol), e.g. ruined-studio.myshopify.com
SHOPIFY_STORE_DOMAIN=

# Public Storefront API access token.
# Shopify admin → Settings → Apps and sales channels → Develop apps →
# create an app → Storefront API → install → copy the Storefront access token.
# Grant: unauthenticated_read_product_listings, unauthenticated_write_checkouts.
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Optional — Storefront API version (defaults to 2026-07 in src/lib/shopify.ts).
SHOPIFY_API_VERSION=2026-07

# Public Shopify-hosted checkout hostname. Keep the storefront on Vercel and
# connect a dedicated Shopify domain such as checkout.theruinedproject.com so
# customers never see the myshopify.com address returned by Cart.checkoutUrl.
SHOPIFY_CHECKOUT_DOMAIN=checkout.theruinedproject.com

# Shopify app client secret used by /api/revalidate to verify the
# X-Shopify-Hmac-Sha256 webhook signature. Do not use the public Storefront
# token here.
SHOPIFY_WEBHOOK_SECRET=

# ─── Stripe Membership Billing ───────────────────────────────────────────────
# Stripe is for Ruined membership, consulting invoices, and related tax only.
# Shopify remains the system of record for the retail store and physical goods.
# Use test-mode keys locally, then separate live-mode secrets in production.
# Never prefix either server secret with NEXT_PUBLIC_.

# Browser-safe Stripe publishable key used only to mount Embedded Checkout.
# Pair pk_test_ with test-mode server credentials and pk_live_ only in production.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Test secret or restricted key. A restricted key should grant only the
# Checkout, Billing, Customer Portal, Customer, Invoice, and webhook operations
# required by this integration. Fee reconciliation also reads Invoice Payments,
# PaymentIntents, Charges, Refunds and Credit Notes. Tax quotes require Tax
# Calculations when automatic tax is enabled; see docs/stripe-integration.md.
STRIPE_SECRET_KEY=

# Signing secret for this exact webhook endpoint/environment. The Stripe CLI
# and the Dashboard endpoint each issue a different whsec_ value.
STRIPE_WEBHOOK_SECRET=

# Individual base prices: $499 USD monthly or $4,990 USD upfront annually.
# Existing standard-price compatibility settings, distinct prices, quantity one.
# New purchases use the six-offer catalog below and a server-issued offer ID.
STRIPE_MEMBERSHIP_MONTHLY_PRICE_ID=
STRIPE_MEMBERSHIP_ANNUAL_PRICE_ID=

# Optional per-offer overrides. Blank uses the verified mode-specific catalog.
STRIPE_MEMBERSHIP_INDIVIDUAL_MONTHLY_PRICE_ID=
STRIPE_MEMBERSHIP_INDIVIDUAL_ANNUAL_PRICE_ID=
STRIPE_MEMBERSHIP_FOUNDING_INDIVIDUAL_MONTHLY_PRICE_ID=
STRIPE_MEMBERSHIP_FOUNDING_INDIVIDUAL_ANNUAL_PRICE_ID=
STRIPE_MEMBERSHIP_COUPLE_MONTHLY_PRICE_ID=
STRIPE_MEMBERSHIP_COUPLE_ANNUAL_PRICE_ID=

# Exact published version covering paid signup, e.g. ruined_membership-v2.
# Leave empty until approved paid terms exist. Pilot agreements cannot charge.
STRIPE_MEMBERSHIP_PAID_AGREEMENT_VERSION=

# Live charging stays disabled until sandbox checkout, webhooks and policies pass.
STRIPE_MEMBERSHIP_LIVE_ENABLED=false

# Keep false until the implemented offer has passed provider acceptance checks
# and publication, tax, hosting and production configuration are ready.
# Blocks new paid checkout/public signup in both test and live environments.
STRIPE_MEMBERSHIP_COMMERCIAL_READY=false
# Optional prelaunch payment-method storage. Does not release paid Checkout.
STRIPE_MEMBERSHIP_PAYMENT_SETUP_ENABLED=false
# Independently open public direct-invitation signup while paid Checkout is held.
# Requires payment setup readiness; without this, only existing invited accounts can save.
STRIPE_MEMBERSHIP_PAYMENT_SETUP_SIGNUP_ENABLED=false
# Collect NEW registrations with required card saving (complimentary exempt).
# Keep their profiles locked until administrator release; existing members stay open.
# This also closes paid Checkout. Requires the member_registration_access migration.
MEMBERSHIP_REGISTRATION_ONLY_ENABLED=false
# Pinned on NEW registrations only. Requires activation/cohort payment readiness;
# missing prerequisites close signup instead of falling back to saving a card.
MEMBERSHIP_REGISTRATION_PREPAYMENT_REQUIRED=false
# Exact published registration-only terms. Keep separate from the paid agreement.
# Set only after the reviewed document is published (for example ruined_registration-v1).
MEMBERSHIP_REGISTRATION_TERMS_VERSION=
# Exact account that owns the setup key and webhook; separate sandbox/live IDs.
STRIPE_PAYMENT_SETUP_ACCOUNT_ID=

# Foundations opens separately from payment setup and paid membership.
# Closed for every environment and role unless explicitly true. Local demos
# must opt in here as well; never use a public/browser environment variable.
MEMBERSHIP_FOUNDATIONS_LAUNCHED=false

# Required environment-specific Customer Portal configuration. Must permit invoice
# history, payment updates, and period-end cancellation without proration;
# subscription plan changes must stay disabled. No default configuration fallback.
STRIPE_BILLING_PORTAL_CONFIGURATION_ID=
# V2 contracts use a separate portal for invoices/payment updates only.
# Cancellation stays available in /my/account, using the accepted commitment.
STRIPE_MEMBERSHIP_COMMITMENT_PORTAL_CONFIGURATION_ID=
# Separate member-confirmed paid activation while registration/profile holds remain.
# Enable only with the published paid agreement and verified billing release.
STRIPE_MEMBERSHIP_ACTIVATION_ENABLED=false
# First payment date disclosed before authorization; no automatic enrollment.
# November 1, 2026 at midnight America/Denver. Later new purchases pay at checkout.
STRIPE_MEMBERSHIP_FIRST_CHARGE_AT=2026-11-01T06:00:00Z
# Reviewed fee tax classification and cancellation acceptance tests required.
# Keep false until both are complete; no-fee renewal cancellation stays available.
STRIPE_MEMBERSHIP_BUYOUT_READY=false
STRIPE_MEMBERSHIP_BUYOUT_TAX_CODE=

# Transactional annual renewals and initial monthly commitment anniversary
# notices at 40 and 20 days. Keep OFF until provider checks and actual delivery
# are verified. Monthly anniversaries are separate from monthly invoice dates.
STRIPE_MEMBERSHIP_RENEWAL_EMAILS_ENABLED=false
# Required in test mode: all sandbox notices go only to this approved test inbox.
STRIPE_MEMBERSHIP_RENEWAL_TEST_RECIPIENT=

# Legacy recurring price: reconciliation for existing subscriptions only.
# Never used to create a new membership purchase.
STRIPE_MEMBERSHIP_PRICE_ID=

# Keep false until the Ruined Stripe account has an active tax registration,
# verified business origin, and a confirmed membership Product tax code.
STRIPE_TAX_ENABLED=false

# Minimum age shown in the versioned member attestation. This is configurable
# because the policy still needs final legal confirmation before production.
MEMBERSHIP_MINIMUM_AGE=18

# Durable Postgres storage for webhook idempotency and the billing/member map.
# Run `npm run db:migrate:platform` before registering the webhook endpoint.
DATABASE_URL=

# ─── Ruined Membership platform identity ────────────────────────────────────
# Preview is honored only outside production and never creates a fake session.
# Set connected after Supabase Auth and the platform migration are ready.
PLATFORM_MODE=preview

# Google Chat/Meet links are partitioned between test and live records. Set
# this explicitly to false for testing or true for production. If left blank,
# member links and operator writes stay disabled rather than choosing a mode.
GOOGLE_COMMUNICATIONS_LIVEMODE=

# Google Calendar invitations authenticate directly as the configured organizer
# when all three OAuth values below are present. Otherwise, the legacy dedicated
# service-account configuration remains available. Keep disabled until the API,
# organizer identity, narrow scope, credentials, and a real invite are verified.
GOOGLE_CALENDAR_ENABLED=false
# The Workspace user authenticated as the event organizer. This account owns
# the invites and Meet rooms; use cade@theruinedproject.com for direct OAuth.
GOOGLE_CALENDAR_ORGANIZER_EMAIL=cade@theruinedproject.com
# `primary` means the primary calendar of the authenticated organizer.
GOOGLE_CALENDAR_CALENDAR_ID=primary
# Server-only credentials from the one-time organizer OAuth grant. OAuth is
# preferred only when this complete set is present; partial values are ignored.
GOOGLE_CALENDAR_OAUTH_CLIENT_ID=
GOOGLE_CALENDAR_OAUTH_CLIENT_SECRET=
GOOGLE_CALENDAR_OAUTH_REFRESH_TOKEN=
# Backward-compatible fallback: base64-encoded JSON for a dedicated Calendar
# service account with domain-wide delegation. Never reuse the Sheets account.
GOOGLE_CALENDAR_SERVICE_ACCOUNT_JSON_BASE64=

# Hidden on production and preview deployments until this public release switch
# is explicitly enabled. Local development remains available without it.
NEXT_PUBLIC_MY_RUINED_ENABLED=false

# Supabase Project URL and publishable key. These power passwordless identity;
# Postgres remains the canonical member/state store.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-side private member-photo storage (bucket: member-portraits).
# Use the existing project's server secret; never send it to a client.
# Never prefix this key with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Optional endpoint for sendBeacon Web Vitals payloads.
NEXT_PUBLIC_ANALYTICS_ENDPOINT=

# Canonical production origin. Keep this exact value in production so metadata,
# robots.txt, and sitemap.xml all resolve to the public brand domain.
NEXT_PUBLIC_SITE_URL=https://theruinedproject.com

# Public destination used by fallback product enquiry links.
NEXT_PUBLIC_CONTACT_EMAIL=connect@theruinedproject.com

# Public email interests and consent are stored in the Supabase Postgres
# database above. Campaign delivery is intentionally separate. Add a Resend
# API key only when the outbox worker and signed webhook receiver are enabled.
RESEND_MARKETING_ENABLED=false
RESEND_API_KEY=
# Lifecycle groups for membership service updates. Never grants newsletter consent.
# Disabled by default. Two dedicated, exactly named segments; do not use General.
RESEND_MEMBER_SEGMENT_SYNC_ENABLED=false
RESEND_MEMBER_WAITING_SEGMENT_ID=
RESEND_MEMBER_PROFILES_OPEN_SEGMENT_ID=
RESEND_FROM_EMAIL=Ruined <connect@theruinedproject.com>
# Transactional registration welcome and later profile-ready messages.
# Independent of marketing consent; see docs/member-registration-launch.md.
MEMBER_REGISTRATION_EMAILS_ENABLED=false
# Saved-card registration follow-up tasks and private work queue emails.
# Libby must have verified email and active Administrator access.
# Server workers only; never charge cards or release member profiles.
OPERATOR_REGISTRATION_WORK_ENABLED=false
OPERATOR_WORK_QUEUE_DIGEST_ENABLED=false
# Etc/GMT+7 = fixed MST. America/Denver adjusts for daylight saving.
OPERATOR_WORK_QUEUE_DIGEST_TIMEZONE=America/Denver
# One general Ruined updates audience shared by every public signup form.
RESEND_TOPIC_UPDATES_ID=
# Legacy topic IDs remain configured only to preserve historical preferences.
RESEND_TOPIC_ARTIFACTS_ID=
RESEND_TOPIC_STORE_ID=

# Resend signs events sent to /api/webhooks/resend with this endpoint-specific
# secret. The worker route accepts Vercel Cron requests using CRON_SECRET.
RESEND_WEBHOOK_SECRET=
CRON_SECRET=

# One-way private operations mirror for BYOB Nº 02 registrations. Supabase
# Postgres remains canonical; keep disabled until the dedicated service account
# has Editor access to only the target Sheet and its tab is named Registrants.
GOOGLE_REGISTRATION_SHEET_ENABLED=false
GOOGLE_REGISTRATION_SPREADSHEET_ID=
# Base64-encoded JSON for a dedicated Google service account with no domain-wide
# delegation. This is server-only and should be set only in production secrets.
GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON_BASE64=

# Dedicated HMAC key for public signup throttling. Generate a separate random
# value; do not reuse the Supabase, Resend, Stripe, or cron secrets.
COMMUNICATION_RATE_LIMIT_SECRET=
# Transactional contact delivery uses Resend independently of marketing.
# Defaults to NEXT_PUBLIC_CONTACT_EMAIL when left blank.
CONTACT_TO_EMAIL=
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=

# Administrator Resend frontend: server-only OpenAI API credentials.
# A ChatGPT subscription does not configure this server integration.
OPENAI_API_KEY=
OPENAI_EMAIL_MODEL=gpt-4.1-mini
# Enable after both admin-email migrations are deployed and Resend is configured.
# Uses the existing full-access RESEND_API_KEY; template sender or RESEND_FROM_EMAIL.
# Campaigns use the existing Resend segments, topics and unsubscribe design.
ADMIN_EMAIL_SENDING_ENABLED=false
