{
  "name": "immersive-parallax-app",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "predev": "npm run sequences",
    "dev": "next dev",
    "prebuild": "npm run sequences",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs tests/*.test.mts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "db:migrate:platform": "node --env-file-if-exists=.env.local scripts/migrate-platform.mjs",
    "db:migrate:stripe": "node --env-file-if-exists=.env.local scripts/migrate-stripe.mjs",
    "assets:scenes": "node scripts/optimize-scenes.mjs",
    "assets:brand": "node scripts/gen-brand-assets.mjs",
    "sequences": "node scripts/build-mobile-sequences.mjs && node scripts/build-sequences.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "@shopify/storefront-api-client": "^1.0.10",
    "@stripe/stripe-js": "9.14.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "google-auth-library": "11.0.2",
    "gsap": "^3.15.0",
    "i18n-iso-countries": "7.14.0",
    "lenis": "^1.3.25",
    "libphonenumber-js": "1.13.7",
    "motion": "12.23.24",
    "next": "^15.5.24",
    "parse5": "8.0.1",
    "postcss": "^8.5.26",
    "postgres": "^3.4.9",
    "postprocessing": "^6.39.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "resend": "6.21.0",
    "server-only": "^0.0.1",
    "stripe": "^22.5.0",
    "three": "^0.185.1",
    "tw-animate-css": "1.3.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.12",
    "@types/node": "20.14.10",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.24",
    "puppeteer": "^25.3.0",
    "sharp": "^0.35.3",
    "tailwindcss": "4.1.12",
    "typescript": "5.6.3"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.26"
    }
  }
}
